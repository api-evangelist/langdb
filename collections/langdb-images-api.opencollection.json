{
  "opencollection": "1.0.0",
  "info": {
    "name": "LangDB AI Gateway Analytics Images API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an image",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.us-east-1.langdb.ai/{project_id}/v1/images/generations",
            "headers": [
              {
                "name": "X-Project-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates one or more images from a text prompt using an image-capable model routed through the gateway."
        }
      ]
    }
  ],
  "bundled": true
}